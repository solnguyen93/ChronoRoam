# Loaded automatically by `npm start` (CRA sets NODE_ENV=development for that script) — takes
# priority over the base .env for REACT_APP_BASE_URL, so local dev always talks to the local
# backend regardless of whatever .env.production says. See .env.production for the counterpart.
REACT_APP_BASE_URL=http://localhost:5000
# See .env.production's comment — this is the equivalent for local dev, where the frontend really
# is served from window.location.origin correctly, so this just matches it for consistency.
REACT_APP_PUBLIC_URL=http://localhost:3000
