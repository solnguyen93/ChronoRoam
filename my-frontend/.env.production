# Loaded automatically by `npm run build` (CRA sets NODE_ENV=production for that script) — this
# is what gets baked into any real production build (Cloudflare Pages, or the standalone iOS
# build for the App Store later). Local dev (npm start) never reads this — see .env.development.
REACT_APP_BASE_URL=https://api-chronoroam-app.onrender.com

# The app's own real public web origin — NOT the same as window.location.origin (see
# ShareModal.js), which inside the Capacitor iOS app resolves to a local WebView scheme
# (capacitor://localhost or similar), not this real domain. A share link/QR code built from
# window.location.origin from within the native app is meaningless to whoever scans/opens it —
# this is the one place a share link must always point to, regardless of which build generated it.
REACT_APP_PUBLIC_URL=https://chronoroam.app
