# REACT_APP_BASE_URL now lives in .env.development / .env.production instead of here (CRA loads
# those with higher priority than this file for their respective NODE_ENV, so anything set here
# would just be a fallback neither npm start nor npm run build actually reaches) — see those two
# files. This one's left for flags that don't need to differ between dev and production.
REACT_APP_ENABLE_AI_FLIGHT_EXTRACTION=true
# Forward-a-confirmation-email feature (see EmailImportReviewModal.js). Also needs
# EMAIL_INTAKE_SHARED_SECRET set in my-backend/.env — this flag alone just controls whether Home
# bothers checking for pending imports; the backend webhook is separately gated.
REACT_APP_ENABLE_EMAIL_IMPORT=true
# Stripe's publishable key (safe to expose client-side by design — the secret key stays backend-
# only, see my-backend/.env). Same TEST-mode key on both dev and prod for now; swap for the live
# key once ready to take real payments.
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_51U3yssGsmpWbvUDGUfWiLmgwy3qy5tBO2vajIB0AKUZOqeSIKH2KSPxTGOy39eeds9zDn9TsSrQS9ry1dDUv0tQV00YWf3L3q6
